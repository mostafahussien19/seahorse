{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "project_id",
    "title",
    "goal",
    "assigned_to",
    "scope",
    "acceptance_criteria",
    "status",
    "dependencies",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Format: task-001, task-002, task-fix-001"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence: what this task achieves"
    },
    "assigned_to": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Role id of the agent that owns this task, as listed in core.md (for example api_agent or reviewer_agent)."
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in",
        "out"
      ],
      "properties": {
        "in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "needs_review",
        "done",
        "blocked"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Task IDs this depends on. Empty array if none."
    },
    "review_notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Set by reviewer_agent if changes needed"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  }
}
